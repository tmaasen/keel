{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source companion for people whose work has been changed by AI. Values first, then vocation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p convex",
    "convex": "convex dev",
    "deploy": "static-hosting deploy --build-command 'pnpm build'"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "0.2.1",
    "convex": "^1.46.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
